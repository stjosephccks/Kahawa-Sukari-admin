# M-Pesa Daraja API Configuration
# Get these credentials from Safaricom Developer Portal (https://developer.safaricom.co.ke/)

# M-Pesa Environment (sandbox or production)
MPESA_ENVIRONMENT=sandbox

# M-Pesa Consumer Key and Secret (from Daraja API)
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here

# M-Pesa Passkey (for STK Push - if using STK Push)
MPESA_PASSKEY=your_passkey_here

# M-Pesa Shortcode / Paybill Number
MPESA_SHORTCODE=174379

# M-Pesa Paybill Numbers (for C2B - can have multiple)
# Primary paybill
MPESA_PAYBILL_PRIMARY=your_primary_paybill
# Secondary paybill (optional)
MPESA_PAYBILL_SECONDARY=your_secondary_paybill

# SMS API Configuration
SMS_API_URL=https://bulksms.afrinettelecom.co.ke/api/services
SMS_PARTNER_ID=your_partner_id
SMS_API_KEY=your_api_key
SMS_SHORTCODE=your_shortcode

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/kahawa-sukari

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here
