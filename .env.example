# M-Pesa Daraja API Configuration
# Get these credentials from Safaricom Developer Portal (https://developer.safaricom.co.ke/)

# M-Pesa Environment (sandbox or production)
MPESA_ENVIRONMENT=sandbox

# Parish M-Pesa Credentials
MPESA_PARISH_CONSUMER_KEY=your_parish_consumer_key_here
MPESA_PARISH_CONSUMER_SECRET=your_parish_consumer_secret_here
MPESA_PARISH_PASSKEY=your_parish_passkey_here
MPESA_PARISH_PAYBILL=your_parish_paybill

# Outstation M-Pesa Credentials (different from parish)
MPESA_OUTSTATION_CONSUMER_KEY=your_outstation_consumer_key_here
MPESA_OUTSTATION_CONSUMER_SECRET=your_outstation_consumer_secret_here
MPESA_OUTSTATION_PASSKEY=your_outstation_passkey_here
MPESA_OUTSTATION_PAYBILL=your_outstation_paybill

# Note: Both parish and outstation share the same zaka member database
# Payments from either paybill will be matched to the same zaka members

# SMS API Configuration
SMS_API_URL=https://bulksms.afrinettelecom.co.ke/api/services
SMS_PARTNER_ID=your_partner_id
SMS_API_KEY=your_api_key
SMS_SHORTCODE=your_shortcode

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/kahawa-sukari

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here
